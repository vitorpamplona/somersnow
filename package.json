{
  "name": "somerwalks",
  "version": "1.0.0",
  "private": true,
  "description": "SomerWalks: the Somerville snow guide, storm replays and bus tools for people who walk, roll or ride, by the Somerville PTAC.",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8080 --directory docs",
    "test": "node --test test/*.test.js",
    "cards": "node scripts/render-cards.mjs",
    "data": "python3 scripts/fetch_data.py",
    "pages": "python3 scripts/build_pages.py",
    "verify": "node scripts/verify.mjs",
    "flyer": "node scripts/render-flyer.mjs",
    "lights": "node scripts/render-lights.mjs",
    "letter": "python3 scripts/build_letter.py && node scripts/print-letter.mjs",
    "trips": "python3 analysis/bus-trips/build.py"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
